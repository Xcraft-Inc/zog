#!/usr/bin/env node
"use strict";

const path = require("node:path");
const fs = require("node:fs");

const xcraftRoot = path.join(__dirname, "..");
process.env.XCRAFT_ROOT = xcraftRoot;
fs.writeFileSync(
  path.join(__dirname, "../etc/xcraft/config.json"),
  JSON.stringify({ xcraftRoot })
);

const xEtc = require("xcraft-core-etc")();

/* Load all default settings */
const override = path.join(__dirname, "../etc.js");
xEtc.createAll(
  path.join(__dirname, "../node_modules/"),
  /^(goblin-|(xcraft-(core|contrib)))/,
  override
);

if (process.argv.indexOf("--") === -1) {
  process.argv.push("--");
}

/* Load the Zog Shell */
require("xcraft-zog/bin/zog");
